# Spotify Developer app credentials — https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Last.fm API key — https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key

# Postgres connection (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spotify_data
DB_USER=spotify_user
DB_PASSWORD=spotify_pass

# Gemini API key for the optional AI mood labeler (ingest_llm_moods.py) - https://aistudio.google.com/apikey
# On Google's free tier, prompts may be used to improve its products; only song metadata is ever sent.
GEMINI_API_KEY=your_gemini_api_key
# Optional; defaults to gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
